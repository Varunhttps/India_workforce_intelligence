# Copy to .streamlit/secrets.toml and fill in real values. Never commit secrets.
ALLOWED_EMAILS = [] # Add only invited Google account email addresses
GOOGLE_SHEET_ID = "YOUR_SPREADSHEET_ID"
GOOGLE_SERVICE_ACCOUNT_JSON = '{"type":"service_account","replace_with":"your full JSON key"}'
# Optional: only needed if approved users can dispatch research runs.
# GITHUB_TOKEN = "YOUR_GITHUB_ACTIONS_TOKEN"

[auth]
redirect_uri = "https://YOUR-DEPLOYED-APP-URL"
cookie_secret = "REPLACE_WITH_LONG_RANDOM_SECRET"
client_id = "YOUR_GOOGLE_OAUTH_CLIENT_ID"
client_secret = "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
